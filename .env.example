# Backend datasource (Neon/PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DB?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=YOUR_NEON_USER
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Bootstrap admin (change in real .env)
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@01blog.local
APP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
